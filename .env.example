# Copy to .env and export these in your process manager. The app reads process.env only
# (no dotenv dependency), so nothing is loaded automatically.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=./data/withinreach.db
# Set to 1 ONLY when behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=0
CURRENCY=USD
TAX_RATE=0
# Used by `npm run seed` to create the first admin. If unset, a random password is generated and printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Support channels shown on /help (leave blank to hide a channel)
SUPPORT_PHONE=
SUPPORT_SMS=
SUPPORT_EMAIL=help@example.com
SUPPORT_RELAY=
